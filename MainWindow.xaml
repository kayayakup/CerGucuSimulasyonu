                                        <DataGridTextColumn Header="Senaryo" Binding="{Binding Scenario.Name}" Width="*"/>
                                        <DataGridTextColumn Header="Süre [s]" Binding="{Binding DurationSeconds}" Width="65"/>
                                        <DataGridTextColumn Header="Min. gerilim [V]" Binding="{Binding MinimumTrainVoltageV, StringFormat='{}{0:N1}'}" Width="95"/>
                                        <DataGridTextColumn Header="Max. TM yük [%]" Binding="{Binding MaximumSubstationLoadPercent, StringFormat='{}{0:N1}'}" Width="95"/>
                                        <DataGridTextColumn Header="Enerji [kWh]" Binding="{Binding TotalConsumedEnergyKwh, StringFormat='{}{0:N2}'}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Border Background="#161827" CornerRadius="6" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Minimum tren gerilimi" Foreground="#94A3B8" FontSize="10"/>
                                            <TextBlock Text="{Binding LastRunResult.MinimumTrainVoltageV, StringFormat='{}{0:N1} V'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#161827" CornerRadius="6" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Maksimum TM yükü" Foreground="#94A3B8" FontSize="10"/>
                                            <TextBlock Text="{Binding LastRunResult.MaximumSubstationLoadPercent, StringFormat='%{0:N1}'}" Foreground="#F59E0B" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="Seçilen saniyedeki trenler" Foreground="#38BDF8" FontWeight="Bold" Margin="2,2,0,5"/>
                                <DataGrid ItemsSource="{Binding SelectedSnapshot.Trains}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Background="#161827" Foreground="White" RowBackground="#161827" AlternatingRowBackground="#1B1C2E" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tren" Binding="{Binding TrainName}" Width="70"/>
                                        <DataGridTextColumn Header="Hat" Binding="{Binding Line}" Width="45"/>
                                        <DataGridTextColumn Header="Konum [m]" Binding="{Binding PositionM, StringFormat='{}{0:N0}'}" Width="75"/>
                                        <DataGridTextColumn Header="Hız [km/h]" Binding="{Binding SpeedKmh, StringFormat='{}{0:N1}'}" Width="75"/>
                                        <DataGridTextColumn Header="Güç [kW]" Binding="{Binding PowerKw, StringFormat='{}{0:N1}'}" Width="70"/>
                                        <DataGridTextColumn Header="Gerilim [V]" Binding="{Binding VoltageV, StringFormat='{}{0:N1}'}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Seçilen saniyedeki cer trafoları" Foreground="#C084FC" FontWeight="Bold" Margin="2,2,0,5"/>
                                <DataGrid ItemsSource="{Binding SelectedSnapshot.Substations}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Background="#161827" Foreground="White" RowBackground="#161827" AlternatingRowBackground="#1B1C2E">
