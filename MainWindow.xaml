                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Saniye" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="3600" Value="{Binding SelectedReportSecond, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1"/>
