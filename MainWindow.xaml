             ALT DURUM ÇUBUĞU (STATUS BAR)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#141524" BorderBrush="#2F314C" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#C5C7D9" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TxtCursorInfo" Text="📍 Konum: 0 m | Hat: H1" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" FontSize="12"/>
                    <Separator Width="1" Height="14" Background="#2F314C" Margin="6,0"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='Zoom: %{0:P0}'}" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
