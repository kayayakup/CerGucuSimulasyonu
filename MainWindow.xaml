<Window x:Class="CerGucuSimulasyonu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CerGucuSimulasyonu.ViewModels"
        xmlns:models="clr-namespace:CerGucuSimulasyonu.Models"
        mc:Ignorable="d"
        Title="⚡ Gebze-Darıca Metro Cer Gücü &amp; Sinyalizasyon Canlı Simülasyonu ve Analiz Sistemi"
        Height="840" Width="1520"
        MinHeight="720" MinWidth="1180"
        Background="#10111D"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- DataGrid Başlık Stili: Siyah, Okunaklı, Kontrastlı ve Şık -->
        <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Hücre Stili -->
        <Style x:Key="CustomDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CustomDataGridHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource CustomDataGridCellStyle}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <!-- TabItem Stili (Koyu Tema İle Uyumlu, Okunaklı Başlıklar) -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#1C1E32" CornerRadius="6,6,0,0" Padding="14,8" Margin="0,0,4,0" BorderBrush="#2C2F4D" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="#94A3B8" TextElement.FontWeight="SemiBold" TextElement.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2D4A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="TextElement.Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#242740"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Mod Seçim Butonları Stili (Yüksek Kontrast, Okunaklı ve Şık) -->
        <Style x:Key="ModeToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E2238"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#3E446E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2E3458"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Left Sidebar + Center Canvas) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ÜST ARAÇ ÇUBUĞU (TOOLBAR & SIMULATION CONTROLS)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#181928" BorderBrush="#2A2C44" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                
                <!-- SOL ALAN: SİMÜLASYON OYNATMA, HIZ VE MOD SEÇİM BUTONLARI -->
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- SİMÜLASYON OYNATMA VE HIZ -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Command="{Binding ToggleSimulationCommand}" Margin="1,0" Padding="10,4" FontWeight="Bold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Content" Value="▶ Başlat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulationRunning}" Value="True">
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Setter Property="Content" Value="⏸ Durdur"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ResetSimulationCommand}" Content="🔄 Sıfırla" Background="#24263D" Foreground="#E2E8F0" BorderBrush="#3F4263" Margin="2,0" Padding="6,4" Cursor="Hand"/>

                        <Border Background="#0F101A" CornerRadius="4" Padding="6,3" Margin="4,0" BorderBrush="#2F314C" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " Foreground="#FACC15"/>
                                <TextBlock Text="{Binding SimulationTimeString}" FontWeight="Bold" Foreground="#FACC15" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                        <!-- Hız -->
                        <Button Command="{Binding SetSpeedCommand}" CommandParameter="1.0" Content="1x" Background="#23243B" Foreground="White" BorderBrush="#3F4263" Margin="1,0" Padding="5,2" Cursor="Hand"/>
                        <Button Command="{Binding SetSpeedCommand}" CommandParameter="2.0" Content="2x" Background="#23243B" Foreground="White" BorderBrush="#3F4263" Margin="1,0" Padding="5,2" Cursor="Hand"/>
                        <Button Command="{Binding SetSpeedCommand}" CommandParameter="5.0" Content="5x" Background="#23243B" Foreground="White" BorderBrush="#3F4263" Margin="1,0" Padding="5,2" Cursor="Hand"/>
                    </StackPanel>

                    <Separator Width="1" Height="20" Background="#2F314C" Margin="4,0"/>

                    <!-- Mod Seçim Butonları -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <RadioButton x:Name="BtnModeSelect" GroupName="ToolMode" Content="🔍Seç" IsChecked="True" 
                                     Click="OnModeChanged" Tag="SELECT"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeStation" GroupName="ToolMode" Content="🚉 İstasyon" 
                                     Click="OnModeChanged" Tag="STATION"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeTrafo" GroupName="ToolMode" Content="⚡ Trafo" 
                                     Click="OnModeChanged" Tag="TRAFO"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeSpeed" GroupName="ToolMode" Content="🚦 Hız" 
                                     Click="OnModeChanged" Tag="SPEED"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeEgim" GroupName="ToolMode" Content="📐 Eğim" 
                                     Click="OnModeChanged" Tag="EGIM"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeKurp" GroupName="ToolMode" Content="↩ Kurp" 
                                     Click="OnModeChanged" Tag="KURP"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>

                        <RadioButton x:Name="BtnModeParallel" GroupName="ToolMode" Content="⊥ Paralel" 
                                     Click="OnModeChanged" Tag="PARALLEL"
                                     Style="{StaticResource ModeToggleButtonStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- SAĞ ALAN: BUTONLAR -->
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="OnOpenStartupWizard" Content="⚙️ Parametre Sihirbazı" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="2,0" Padding="8,4" FontWeight="Bold" Cursor="Hand"/>
                    <Button Command="{Binding GenerateRandomTrainsCommand}" Content="🎲 Tren Üret" Background="#7C4DFF" Foreground="White" BorderThickness="0" Margin="2,0" Padding="8,4" FontWeight="Bold" Cursor="Hand"/>
                    <Button Command="{Binding AddSingleTrainCommand}" Content="🚃 +1 Tren" Background="#24263D" Foreground="#38BDF8" BorderBrush="#38BDF8" Margin="2,0" Padding="6,4" Cursor="Hand"/>
                    <Button Command="{Binding ZoomInCommand}" Content="🔍+" ToolTip="Yakınlaştır" Margin="1,0" Padding="6,4" Cursor="Hand"/>
                    <Button Command="{Binding ZoomOutCommand}" Content="🔍-" ToolTip="Uzaklaştır" Margin="1,0" Padding="6,4" Cursor="Hand"/>
                    <Button Command="{Binding ZoomResetCommand}" Content="🔄 %100" ToolTip="Yakınlaştırmayı Sıfırla" Margin="1,0" Padding="6,4" Cursor="Hand"/>
                    <Button Command="{Binding SaveDataCommand}" Content="💾 Kaydet" Background="#059669" Foreground="White" BorderThickness="0" Margin="3,0" Padding="8,4" Cursor="Hand"/>
                    <Button Command="{Binding LoadDataCommand}" Content="📂 Yükle" Margin="1,0" Padding="6,4" Cursor="Hand"/>
                    <Button Command="{Binding ExportWordReportCommand}" Content="📝 Word Raporu" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="3,0" Padding="8,4" Cursor="Hand"/>
                    <Button Command="{Binding ExportExcelReportCommand}" Content="📊 Excel Raporu" Background="#16A34A" Foreground="White" BorderThickness="0" Margin="1,0" Padding="8,4" Cursor="Hand"/>
                    <Button Command="{Binding RunAllScenariosCommand}" Content="▶ Tüm Senaryolar" Background="#9333EA" Foreground="White" BorderThickness="0" Margin="3,0" Padding="8,4" Cursor="Hand"/>
                </WrapPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ANA İÇERİK ALANI (ÜST GENİŞ HAT CANVAS'I + ALT PANEL TABLARI)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Üst: Hat İnteraktif Geniş Görsel Canvas -->
                <RowDefinition Height="11*" MinHeight="260"/>
                <!-- Splitter -->
                <RowDefinition Height="5"/>
                <!-- Alt: Canlı Paneller, Grafikler, Tablolar ve Parametreler -->
                <RowDefinition Height="9*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- 1. ÜST KISIM: 100% GENİŞLİKTE İNTERAKTİF ÇİZİM CANVAS'I -->
            <Grid Grid.Row="0" Background="#0C0D17">
                <ScrollViewer x:Name="CanvasScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="True">
                    <Canvas x:Name="TrackCanvas" 
                            Background="#0C0D17" 
                            Height="480" 
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            MouseDown="TrackCanvas_MouseDown"
                            MouseMove="TrackCanvas_MouseMove"
                            MouseUp="TrackCanvas_MouseUp"
                            MouseWheel="TrackCanvas_MouseWheel"/>
                </ScrollViewer>

                <!-- HAT BİLGİ ETİKETİ (Overlay) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" 
                        Background="#DD141524" CornerRadius="6" Padding="12,6" BorderBrush="#2F314C" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#38BDF8" Margin="0,0,5,0"/>
                        <TextBlock Text="H1 (Darıca → Depo)" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,15,0" FontSize="11"/>
                        <Ellipse Width="10" Height="10" Fill="#FB923C" Margin="0,0,5,0"/>
                        <TextBlock Text="H2 (Depo → Darıca)" Foreground="#FB923C" FontWeight="SemiBold" Margin="0,0,15,0" FontSize="11"/>
                        <TextBlock Text="🚉 12 İstasyon | ⚡ 7 DC Trafo | 🛡️ EN 50122-1" Foreground="#C5C7D9" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- YATAY SPLITTER -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#24263B" Cursor="SizeNS"/>

            <!-- 2. ALT KISIM: CANLI BİLGİLER, GRAFİKLER, TABLOLAR VE PARAMETRELER -->
            <Border Grid.Row="2" Background="#141524" BorderBrush="#25273D" BorderThickness="0,1,0,0">
                <TabControl Background="Transparent" BorderThickness="0" Margin="4">
                    
                    <!-- 1. TAB: CANLI İZLEME & SEÇİLİ NESNE BİLGİSİ -->
                    <TabItem Header="📊 Canlı İzleme &amp; Durum" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
                            <StackPanel>

                                <!-- SİSTEM ÖZETİ CANLI DASHBOARD -->
                                <Border Background="#1C1E32" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#2C2F4D" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                            <Border Background="#10B981" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                                <TextBlock Text="TÜM HAT TOPLAMI" FontWeight="Bold" FontSize="9" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="🌐  SİSTEM GENEL CER &amp; ŞEBEKE ÖZETİ" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8"/>
                                        </DockPanel>

                                        <TextBlock Text="* Aşağıdaki 4 metrik tüm metro hattının toplam anlık cer ve şebeke değerleridir." Foreground="#94A3B8" FontSize="9.5" Margin="0,0,0,6"/>

                                        <UniformGrid Columns="2" Margin="0,2">
                                            <Border Background="#111220" CornerRadius="6" Padding="8" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="Toplam Çekilen Güç" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="{Binding ToplamCekilenGucKw, StringFormat='{}{0:N1} kW'}" FontWeight="Bold" FontSize="14" Foreground="#F59E0B"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#111220" CornerRadius="6" Padding="8" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="Rejeneratif Güç" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="{Binding ToplamRejeneratifGucKw, StringFormat='{}{0:N1} kW'}" FontWeight="Bold" FontSize="14" Foreground="#34D399"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#111220" CornerRadius="6" Padding="8" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="Net Şebeke Yükü" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="{Binding NetSistemGucuKw, StringFormat='{}{0:N1} kW'}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#111220" CornerRadius="6" Padding="8" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="Pik Trafo Yükü" Foreground="#94A3B8" FontSize="10"/>
                                                    <TextBlock Text="{Binding EnYuksekTrafoYukYuzdesi, StringFormat='%{0:N1}'}" FontWeight="Bold" FontSize="14" Foreground="#EC4899"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Grid Margin="0,6,0,2">
                                            <TextBlock Text="Toplam Tüketilen Enerji:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Text="{Binding ToplamTuketilenEnerjiKwh, StringFormat='{}{0:N3} kWh'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Geri Kazanılan Enerji:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Text="{Binding ToplamGeriKazanilanEnerjiKwh, StringFormat='{}{0:N3} kWh'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#34D399" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="En Çok Yüklenen Trafo:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Text="{Binding EnCokYuklenenTrafoAdi}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#C084FC" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Ortalama / Min Gerilim:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="11">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} V / {1:N0} V">
                                                        <Binding Path="OrtalamaKatenerGerilimiV"/>
                                                        <Binding Path="MinHatGerilimiV"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SEÇİLİ NESNEYE ÖZEL CANLI METRİKLER (TRAFO, TREN, PARALELLEME, EĞİM, KURP) -->
                                <Border Background="#1F2238" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#3B3F66" BorderThickness="1.5">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                            <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                                <TextBlock Text="ÖZEL METRİK" FontWeight="Bold" FontSize="9" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="🎯  SEÇİLİ NESNE VE DETAY METRİKLERİ" FontWeight="Bold" FontSize="11.5" Foreground="#FACC15"/>
                                        </DockPanel>

                                        <!-- Seçili Nesne İçeriği -->
                                        <ContentControl Content="{Binding SelectedItem}">
                                            <ContentControl.Resources>
                                                <!-- 1. TREN ŞABLONU VE METRİKLERİ -->
                                                <DataTemplate DataType="{x:Type models:TrenKonumu}">
                                                    <StackPanel>
                                                        <Border Background="#101B33" CornerRadius="6" Padding="8,5" Margin="0,0,0,6" BorderBrush="#2563EB" BorderThickness="1">
                                                            <DockPanel LastChildFill="True">
                                                                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                                                    <TextBlock Text="{Binding Durum}" Foreground="White" FontWeight="Bold" FontSize="9.5"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding TrenAdi, StringFormat='🚃 {0} (Aktif Tren Metrikleri)'}" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                                            </DockPanel>
                                                        </Border>

                                                        <UniformGrid Columns="2" Margin="0,2,0,6">
                                                            <Border Background="#161827" CornerRadius="6" Padding="6" Margin="2">
                                                                <StackPanel>
                                                                    <TextBlock Text="⚡ Çekilen/Verilen Güç" Foreground="#94A3B8" FontSize="9.5"/>
                                                                    <TextBlock Text="{Binding CekilenGucKw, StringFormat='{}{0:N1} kW'}" FontWeight="Bold" FontSize="13.5" Foreground="#F59E0B"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#161827" CornerRadius="6" Padding="6" Margin="2">
                                                                <StackPanel>
                                                                    <TextBlock Text="⚡ Çekilen Akım" Foreground="#94A3B8" FontSize="9.5"/>
                                                                    <TextBlock Text="{Binding CekilenAkimA, StringFormat='{}{0:N1} A'}" FontWeight="Bold" FontSize="13.5" Foreground="#F59E0B"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#161827" CornerRadius="6" Padding="6" Margin="2">
                                                                <StackPanel>
                                                                    <TextBlock Text="🔋 Katener Gerilimi" Foreground="#94A3B8" FontSize="9.5"/>
                                                                    <TextBlock Text="{Binding KatenerGerilimiV, StringFormat='{}{0:N1} V'}" FontWeight="Bold" FontSize="13.5" Foreground="#38BDF8"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#161827" CornerRadius="6" Padding="6" Margin="2">
                                                                <StackPanel>
                                                                    <TextBlock Text="🚀 Anlık Hız" Foreground="#94A3B8" FontSize="9.5"/>
                                                                    <TextBlock Text="{Binding AnlikHiz, StringFormat='{}{0:N1} km/h'}" FontWeight="Bold" FontSize="13.5" Foreground="#10B981"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </UniformGrid>

                                                        <Grid Margin="0,2"><TextBlock Text="Anlık Konum (Hat KM):" Foreground="#9CA3AF" FontSize="11"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="11"><TextBlock.Text><MultiBinding StringFormat="{}{0:N0} m ({1:N3} km)"><Binding Path="Konum"/><Binding Path="Konum" ConverterParameter="1000"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                                        <Grid Margin="0,2"><TextBlock Text="Hat &amp; Seyir Yönü:" Foreground="#9CA3AF" FontSize="11"/><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="11"><TextBlock.Text><MultiBinding StringFormat="{}{0} ({1})"><Binding Path="HatTipi"/><Binding Path="Yon"/></MultiBinding></TextBlock.Text></TextBlock></Grid>
                                                        <Grid Margin="0,2"><TextBlock Text="İvmelenme:" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding Ivme, StringFormat='{}{0:N2} m/s²'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White" FontSize="11"/></Grid>
                                                        <Grid Margin="0,2"><TextBlock Text="Yolcu Yükü:" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding YolcuSayisi, StringFormat='{}{0} Yolcu'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#60A5FA" FontSize="11"/></Grid>
                                                        <Grid Margin="0,2"><TextBlock Text="Sonraki İstasyon:" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding SonrakiIstasyon}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#34D399" FontSize="11"/></Grid>
