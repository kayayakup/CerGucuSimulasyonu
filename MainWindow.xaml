                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#38BDF8" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📑 RAPOR KOŞUSU VE ZAMAN İNCELEME" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
